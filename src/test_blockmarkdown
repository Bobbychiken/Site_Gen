import unittest
from block_markdown import block_to_block_type, BlockType, markdown_to_html_node, extract_title

class TestNodeSplitter(unittest.TestCase):
    def test_block_to_block_type(self):
            # Heading
            self.assertEqual(block_to_block_type("# This is a heading"), BlockType.HEADING)
            self.assertEqual(block_to_block_type("###### This is a deep heading"), BlockType.HEADING)
            
            # Code
            code_block = "```\nprint('hello')\ncode here\n```"
            self.assertEqual(block_to_block_type(code_block), BlockType.CODE)
            
            # Quote
            quote_block = ">This is a quote\n>Multiline quote"
            self.assertEqual(block_to_block_type(quote_block), BlockType.QUOTE)
            
            # Unordered List
            ul_block = "- Item one\n- Item two"
            self.assertEqual(block_to_block_type(ul_block), BlockType.UNORDERED_LIST)
            
            # Ordered List
            ol_block = "1. First item\n2. Second item\n3. Third item"
            self.assertEqual(block_to_block_type(ol_block), BlockType.ORDERED_LIST)
            
            # Paragraph (Default)
            para_block = "This is just a regular old paragraph of text."
            self.assertEqual(block_to_block_type(para_block), BlockType.PARAGRAPH)
    def test_paragraphs(self):
        md = """
This is **bolded** paragraph
text in a p
tag here

This is another paragraph with _italic_ text and `code` here

"""

        node = markdown_to_html_node(md)
        html = node.to_html()
        self.assertEqual(
            html,
            "<div><p>This is <b>bolded</b> paragraph text in a p tag here</p><p>This is another paragraph with <i>italic</i> text and <code>code</code> here</p></div>",
        )


    def test_codeblock(self):
        md = """
```
This is text that _should_ remain
the **same** even with inline stuff
```
"""

        node = markdown_to_html_node(md)
        html = node.to_html()
        self.assertEqual(
            html,
            "<div><pre><code>This is text that _should_ remain\nthe **same** even with inline stuff\n</code></pre></div>",
        )

    def test_extraction(self):
         md = """
         '''
# Super mega header

## Does it actually capture what is desired
# More at 11 
         '''
         """
         md2 = """
         '''
### Super mega header

## Does it actually capture what is desired
# More at 11 
         '''
         """
         md3 = """
         '''
Super mega header

## Does it actually capture what is desired
### More at 11       
         '''
         """
         
         
         self.assertEqual(extract_title(md),"Super mega header")
         self.assertEqual(extract_title(md2),"More at 11")
         with self.assertRaises(Exception):
            extract_title(md3)
    

if __name__ == "__main__":
    unittest.main()