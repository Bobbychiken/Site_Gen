import unittest
from block_markdown import block_to_block_type 

class TestNodeSplitter(unittest.TestCase):
    def test_block_to_block_type(self):
            # Heading
            self.assertEqual(block_to_block_type("# This is a heading"), BlockType.HEADING)
            self.assertEqual(block_to_block_type("###### This is a deep heading"), BlockType.HEADING)
            
            # Code
            code_block = "```\nprint('hello')\ncode here\n```"
            self.assertEqual(block_to_block_type(code_block), BlockType.CODE)
            
            # Quote
            quote_block = ">This is a quote\n>Multiline quote"
            self.assertEqual(block_to_block_type(quote_block), BlockType.QUOTE)
            
            # Unordered List
            ul_block = "- Item one\n- Item two"
            self.assertEqual(block_to_block_type(ul_block), BlockType.UNORDERED_LIST)
            
            # Ordered List
            ol_block = "1. First item\n2. Second item\n3. Third item"
            self.assertEqual(block_to_block_type(ol_block), BlockType.ORDERED_LIST)
            
            # Paragraph (Default)
            para_block = "This is just a regular old paragraph of text."
            self.assertEqual(block_to_block_type(para_block), BlockType.PARAGRAPH)




        
if __name__ == "__main__":
    unittest.main()